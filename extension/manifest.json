{
  "manifest_version": 3,
  "name": "Cinq Jours — YouTube Captions",
  "version": "1.0.0",
  "description": "One-click import of a signed-in YouTube video's captions into the local Cinq Jours app.",
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "http://localhost/*",
    "https://localhost/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/watch*"],
      "js": ["content.js"]
    }
  ],
  "action": { "default_title": "Import captions to Cinq Jours" }
}
